<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit-Konfiguration für die Unit-Tests. Aufruf aus dem Projektordner:
    macOS:   /Applications/XAMPP/xamppfiles/bin/php tools/phpunit.phar
    Windows: C:\xampp\php\php.exe tools\phpunit.phar
  Details: docs/unit-tests.md
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
  <testsuites>
    <testsuite name="Unit">
      <directory>tests/Unit</directory>
    </testsuite>
  </testsuites>
</phpunit>
